# Copy this file to .streamlit/secrets.toml and fill in real provider values.
# Never commit secrets.toml. Register this callback URL with your OIDC provider.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "REPLACE_WITH_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_OIDC_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[privacy]
# Only these signed-in addresses can open the app and view its applicant data.
allowed_emails = ["eskedarteesfayeketema@gmail.com"]
